{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryu-films",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "raulduplessi@yahoo.com" }
  ]
}
